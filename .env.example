# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Docker (optional) ────────────────────────────────────────────────────────
HOST_PORT=3000
WEB_CONCURRENCY=1

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/bank-11

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-very-long-random-secret-here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SOCKET_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── App URLs ─────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# ─── Email — Brevo ────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key-here
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Bank One One

# ─── AI — OpenAI ──────────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: override base URL for custom proxy
OPENAI_BASE_URL=
OPENAI_FALLBACK_MODEL=

# ─── AI — Ollama (optional, local) ────────────────────────────────────────────
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_FALLBACK_MODEL=

# ─── AI — Groq (optional) ─────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=

# ─── Debug flags ──────────────────────────────────────────────────────────────
ASSISTANT_DEBUG_ERRORS=false
SOCKET_DEBUG=false
BANKING_GRAPH_DEBUG=false
ASSISTANT_TRACE_LOGS=false

# ─── Observability — Langfuse (optional) ─────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-2961d495-80ba-4db1-9af8-e717420ad715
LANGFUSE_SECRET_KEY=sk-lf-e665a7d6-f267-4baf-94ef-4d701ff62f80
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_IO=false

# ─── Cleanup job interval (milliseconds) ──────────────────────────────────────
PENDING_REGISTRATION_CLEANUP_INTERVAL_MS=3600000
